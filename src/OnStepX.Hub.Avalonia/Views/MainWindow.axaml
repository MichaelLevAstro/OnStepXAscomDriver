<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASCOM.OnStepX.Views.MainWindow"
        Title="OnStepX ASCOM Driver"
        Width="520" MinWidth="440"
        Height="520" MinHeight="420"
        Icon="avares://OnStepX.Hub.Avalonia/Assets/AppIcon.ico"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="{DynamicResource Font.Sans}">

  <!--
    First window of the Avalonia port. Deliberately not the finished hub: it
    binds the same MainViewModel the WPF hub uses, so what it proves is that
    OnStepX.Core drives a non-WPF UI unchanged — connect, poll, live position,
    theme, fonts and commands.

    The tabs, the slew pad, the console and the visualizer are still to come;
    the standard window chrome stands in for the custom TitleBar until then.
  -->

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <!-- Identity + theme -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="windowTitle" Text="{Binding AppTitle}"/>
        <TextBlock Classes="hint" Text="{Binding AppVersion}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Theme"
              Command="{Binding ToggleThemeCommand}"
              Padding="10,4"/>
    </Grid>

    <!-- Connection -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6"
            Padding="14" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="CONNECTION"/>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="State" Margin="0,0,12,4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding State}" Margin="0,0,0,4"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Transport" Margin="0,0,12,4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding Connection.TransportKind}" Margin="0,0,0,4"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Clients" Margin="0,0,12,0"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding ClientCountText}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Connect"
                  Command="{Binding Connection.ConnectCommand}"
                  IsEnabled="{Binding Connection.ConnectButtonEnabled}"
                  MinWidth="96"/>
          <Button Content="Cancel"
                  Command="{Binding Connection.CancelConnectCommand}"
                  IsEnabled="{Binding Connection.CancelButtonEnabled}"
                  MinWidth="96"/>
          <Button Content="Disconnect"
                  Command="{Binding Connection.DisconnectCommand}"
                  IsEnabled="{Binding Connection.DisconnectButtonEnabled}"
                  MinWidth="96"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Live position, straight off the poll loop in OnStepX.Core -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6"
            Padding="14" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="CURRENT POSITION"/>

        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="RA"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding Position.RightAscension}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Dec"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Position.Declination}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Altitude"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Position.Altitude}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Azimuth"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding Position.Azimuth}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Pier side"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding Position.PierSide}"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="LST / mount"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Classes="mono" Text="{Binding Position.Lst}"/>
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Classes="hint" Margin="0,14,0,0" TextWrapping="Wrap"
               Text="Avalonia port in progress — tabs, slew pad, console and visualizer are still to come."/>
  </Grid>
</Window>
