<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ASCOM.OnStepX.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <!-- Fluent supplies the control templates. The hub's own look is layered
         on top through the brushes in Resources/Themes and the class
         selectors in Typography; porting Controls.xaml replaces most of what
         Fluent draws. -->
    <FluentTheme />
    <StyleInclude Source="avares://OnStepX.Hub.Avalonia/Resources/Typography.axaml"/>
  </Application.Styles>

  <!-- ThemeService adds the Dark/Light dictionary at startup and swaps it on
       toggle, so nothing is merged here. -->

</Application>
