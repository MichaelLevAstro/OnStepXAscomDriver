<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ASCOM.OnStepX</RootNamespace>
    <AssemblyName>ASCOM.OnStepX</AssemblyName>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>OnStepX</Product>
    <Company>OnStepX Community</Company>
    <AssemblyTitle>ASCOM OnStepX Drivers (Telescope + Focuser + Rotator)</AssemblyTitle>
    <Description>ASCOM InprocServer drivers for OnStepX mounts, focusers, and rotators — pipe to OnStepX.Hub.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>9.0</LangVersion>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnStepX.Shared\OnStepX.Shared.csproj" />
  </ItemGroup>

  <!--
    Platform 6 interface assemblies. The driver DLL must marshal ITelescopeV3
    through ASCOM.DeviceInterfaces / ASCOM.Exceptions v6.0.0.0 — the Platform 7
    *.Components NuGet packages carry different interface GUIDs and fail at
    QueryInterface time even though the class GUIDs match.

    These used to be <Reference> elements pointing straight into
    C:\Windows\assembly\GAC_MSIL, which no CI runner has. ASCOM.Platform 6.5.2
    is the ASCOM Initiative's own build-server package of exactly those
    assemblies. Verified against the GAC copy on a Platform 7 machine: same
    strong name (6.0.0.0 / 565de7938946fba7) and every interface GUID in the
    package is present and identical in the installed assembly — Platform 7
    only adds the V4 interfaces alongside them.

    ExcludeAssets="runtime" keeps the old <Private>false</Private> behaviour:
    compile against them, never copy them to output. They are the ASCOM
    Initiative's property and the installed Platform supplies them at runtime.
  -->
  <ItemGroup>
    <PackageReference Include="ASCOM.Platform" Version="6.5.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
