<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ASCOM.OnStepX</RootNamespace>
    <AssemblyName>OnStepX.Hub</AssemblyName>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>OnStepX</Product>
    <Company>OnStepX Community</Company>
    <AssemblyTitle>OnStepX Hub</AssemblyTitle>
    <Description>OnStepX mount mediator — owns serial/TCP link, serves multiple ASCOM clients over a named pipe.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>9.0</LangVersion>
    <StartupObject>ASCOM.OnStepX.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnStepX.Shared\OnStepX.Shared.csproj" />
    <ProjectReference Include="..\OnStepX.Core\OnStepX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Device" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
  </ItemGroup>

  <!-- The astronomy catalogs moved to OnStepX.Core with their manifest names
       intact. The icon stays here: AppIconLoader reads it out of the executing
       assembly for the tray. -->
  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico">
      <LogicalName>ASCOM.OnStepX.AppIcon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
