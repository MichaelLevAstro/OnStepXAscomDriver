<Window x:Class="ASCOM.OnStepX.Views.RotatorAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
        xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rotator — Advanced"
        Width="500" Height="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" ResizeBorderThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" Height="38"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock VerticalAlignment="Center" Margin="14,0" Style="{StaticResource Text.WindowTitle}" Text="Rotator — Advanced"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource Btn.WinClose}" Click="OnOk" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" StrokeStartLineCap="Round"
                  Data="{StaticResource Geo.WinClose}"/>
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel2}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="14,10">
        <Grid>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource Btn.SmPrimary}" Content="Close" Click="OnOk" MinWidth="64"/>
        </Grid>
      </Border>

      <Border Padding="14">
        <c:Section Title="Derotator" IconGeometry="{StaticResource Geo.Rotator}">
          <c:Section.Body>
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Visibility="{Binding IsDerotateCapable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                         Text="Parallactic tracking is not supported by this firmware (AXIS3 reports no derotator capability)."/>
              <StackPanel IsEnabled="{Binding IsDerotateCapable}">
                <CheckBox Content="Enable parallactic tracking" IsChecked="{Binding DerotEnabled}" Margin="0,0,0,8"/>
                <UniformGrid Columns="2">
                  <Button Content="Reverse direction" Command="{Binding ToggleDerotReverseCommand}" Margin="0,0,3,0"/>
                  <Button Content="Goto Parallactic"  Command="{Binding ParallacticCommand}"        Margin="3,0,0,0"/>
                </UniformGrid>
              </StackPanel>
            </StackPanel>
          </c:Section.Body>
        </c:Section>
      </Border>
    </DockPanel>
  </Border>
</Window>
