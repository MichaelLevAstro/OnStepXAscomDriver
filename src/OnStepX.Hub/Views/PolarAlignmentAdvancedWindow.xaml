<Window x:Class="ASCOM.OnStepX.Views.PolarAlignmentAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Polar Alignment — Driver Currents"
        Width="500" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" ResizeBorderThickness="0"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" Height="38"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock VerticalAlignment="Center" Margin="14,0" Style="{StaticResource Text.WindowTitle}"
                     Text="Polar Alignment — Driver Currents"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource Btn.WinClose}" Click="OnCancel"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" StrokeStartLineCap="Round"
                  Data="{StaticResource Geo.WinClose}"/>
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel2}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="14,10">
        <Grid>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Sm}" Content="Apply"  Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn.SmPrimary}" Content="OK" Click="OnOk" MinWidth="64" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn.Sm}" Content="Cancel" Click="OnCancel" MinWidth="64"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Drives AXIS4 as Alt and AXIS5 as Az for a motorized polar alignment wedge. NINA TPPA OAPA bridge auto-binds to a Hub-managed virtual COM pair."/>

        <c:Section Title="TMC Driver Tuning" IconGeometry="{StaticResource Geo.Tracking}">
          <c:Section.Body>
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="Run = motor current during slews. Hold = standstill current as % of run. Higher run = more torque, more heat. Higher hold = better against drift, more standby heat."/>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Run (mA)" Style="{StaticResource Text.Label}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Hold (%)" Style="{StaticResource Text.Label}" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Alt"  Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                <c:NumericBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                              Min="50" Max="3000" Step="50" DecimalPlaces="0"
                              Value="{Binding AltRunMa}"/>
                <c:NumericBox Grid.Row="1" Grid.Column="3" Width="100" HorizontalAlignment="Left"
                              Min="0" Max="100" Step="5" DecimalPlaces="0"
                              Value="{Binding AltHoldPct}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Az"  Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <c:NumericBox Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,8,0,0"
                              Min="50" Max="3000" Step="50" DecimalPlaces="0"
                              Value="{Binding AzRunMa}"/>
                <c:NumericBox Grid.Row="2" Grid.Column="3" Width="100" HorizontalAlignment="Left" Margin="0,8,0,0"
                              Min="0" Max="100" Step="5" DecimalPlaces="0"
                              Value="{Binding AzHoldPct}"/>
              </Grid>

            </StackPanel>
          </c:Section.Body>
        </c:Section>
        </StackPanel>
      </Border>
    </DockPanel>
  </Border>
</Window>
