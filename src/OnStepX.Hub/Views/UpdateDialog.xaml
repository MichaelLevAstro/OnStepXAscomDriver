<Window x:Class="ASCOM.OnStepX.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
        xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OnStepX — Update Available"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <Window.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" ResizeBorderThickness="6"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
      <!-- Mini titlebar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" Height="38"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                     Style="{StaticResource Text.WindowTitle}"
                     Text="OnStepX — Update Available"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource Btn.WinClose}"
                  Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" StrokeStartLineCap="Round"
                  Data="{StaticResource Geo.WinClose}"/>
          </Button>
        </Grid>
      </Border>

      <!-- Footer -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel2}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                     Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis"
                     Text="{Binding StatusText}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Sm}" Content="Cancel"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                    Command="{Binding CancelDownloadCommand}" Margin="0,0,8,0" MinWidth="72"/>
            <Button Style="{StaticResource Btn.Sm}" Content="Later"
                    Click="OnClose" Margin="0,0,8,0" MinWidth="72"/>
            <Button Style="{StaticResource Btn.SmPrimary}" Content="Install Now"
                    Command="{Binding InstallCommand}" MinWidth="100"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Border Padding="18,14,18,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Accent}"
                       Text="{Binding LatestVersionText}"/>
            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,2,0,0">
              <Run Text="Current version: "/>
              <Run Text="{Binding CurrentVersionText, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>

          <ProgressBar DockPanel.Dock="Bottom"
                       Style="{StaticResource Progress.Slim}"
                       Margin="0,10,0,0"
                       Minimum="0" Maximum="100"
                       Value="{Binding DownloadProgress, Mode=OneWay}"
                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

          <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Background="{DynamicResource Brush.PanelInset}" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
              <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}"
                       IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource Brush.Text}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </DockPanel>
  </Border>
</Window>
