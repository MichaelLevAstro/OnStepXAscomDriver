<Window x:Class="ASCOM.OnStepX.Views.FocuserAdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
        xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Focuser — Advanced"
        Width="500" Height="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" ResizeBorderThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" Height="38"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock VerticalAlignment="Center" Margin="14,0" Style="{StaticResource Text.WindowTitle}" Text="Focuser — Advanced"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource Btn.WinClose}" Click="OnCancel" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="10" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" StrokeStartLineCap="Round"
                  Data="{StaticResource Geo.WinClose}"/>
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel2}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              Padding="14,10">
        <Grid>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Sm}" Content="Apply"  Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn.SmPrimary}" Content="OK" Click="OnOk" MinWidth="64" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn.Sm}" Content="Cancel" Click="OnCancel" MinWidth="64"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Padding="14">
        <c:Section Title="Temperature Compensation" IconGeometry="{StaticResource Geo.Focuser}">
          <c:Section.Body>
            <StackPanel IsEnabled="{Binding TempCompAvailable}">
              <TextBlock Style="{StaticResource Text.Hint}"
                         Visibility="{Binding TempCompAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                         Text="This focuser does not report a temperature sensor; TCF is unavailable." Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Temperature" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" Style="{StaticResource Text.Mono}"/>
              </Grid>
              <CheckBox Content="TCF Enabled" IsChecked="{Binding TcfEnabled}" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Coeff (μm/°C)" Style="{StaticResource Text.Label}"/>
                <c:NumericBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                              Min="0" Max="999" Step="0.5" DecimalPlaces="2"
                              Value="{Binding TcfCoeff}"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Deadband (steps)" Style="{StaticResource Text.Label}"/>
                <c:NumericBox Grid.Column="1" Width="100" HorizontalAlignment="Left"
                              Min="1" Max="10000" Step="1" DecimalPlaces="0"
                              Value="{Binding TcfDeadband}"/>
              </Grid>
            </StackPanel>
          </c:Section.Body>
        </c:Section>
      </Border>
    </DockPanel>
  </Border>
</Window>
