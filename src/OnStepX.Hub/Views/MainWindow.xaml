<Window x:Class="ASCOM.OnStepX.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
        xmlns:t="clr-namespace:ASCOM.OnStepX.Views.Tabs"
        xmlns:vm="clr-namespace:ASCOM.OnStepX.ViewModels"
        xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OnStepX ASCOM Driver"
        Width="1280" Height="780"
        MinWidth="1100" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" CornerRadius="0" ResizeBorderThickness="6"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <cv:StringEqualsToVisibilityConverter x:Key="TabActive"/>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel LastChildFill="True">
      <c:TitleBar DockPanel.Dock="Top"/>

      <!-- Global status strip: connection / tracking / slewing on the left,
           live RA/Dec/LST chips + Console toggle on the right. Visible on
           every tab so connection state is always at hand. -->
      <c:StatusStrip DockPanel.Dock="Top"/>

      <!-- Tab bar: animated underline tracks active tab. ItemsSource +
           SelectedId wired in MainWindow code-behind so the PA tab can
           fade in/out as PolarAlignment.IsAvailable flips. -->
      <c:TabBar x:Name="TabBarCtrl" DockPanel.Dock="Top"
                SelectedId="{Binding ActiveTab, Mode=TwoWay}"/>

      <!-- Console drawer at the bottom. Renders only when Console.ConsoleVisible
           (toggle lives on the status strip). Stays mounted so its VM keeps
           buffering log lines while collapsed. -->
      <c:ConsoleView DockPanel.Dock="Bottom" DataContext="{Binding Console}"/>

      <!-- Tab stage: all 5 tab UserControls instantiated; visibility driven
           by ActiveTab so VMs keep polling on inactive tabs (no template
           tear-down per design constraints). -->
      <Grid>
        <t:SetupTab    Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=setup}"/>
        <t:MainTab     Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=main}"/>
        <t:ExtraTab    Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=extra}"/>
        <t:PolarTab    Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=polar}"/>
        <t:SkyModelTab Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=skymodel}"/>
        <t:AdvancedTab Visibility="{Binding ActiveTab, Converter={StaticResource TabActive}, ConverterParameter=adv}"/>
      </Grid>
    </DockPanel>
  </Border>
</Window>
