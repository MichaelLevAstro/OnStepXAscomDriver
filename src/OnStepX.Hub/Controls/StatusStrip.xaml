<UserControl x:Class="ASCOM.OnStepX.Controls.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ASCOM.OnStepX.Controls"
             xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
             Height="36"
             Background="{DynamicResource Brush.Panel2}"
             Focusable="False">
  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <cv:InverseBoolConverter x:Key="Invert"/>
  </UserControl.Resources>
  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT: connection · tracking · slewing -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <c:StatusBadge Status="{Binding Connection.StatusKind}"
                       Pulsing="{Binding Connection.StatusPulse}"
                       Text="{Binding Connection.StatusText}"/>
        <Border Width="1" Height="16" Background="{DynamicResource Brush.BorderStrong}" Margin="10,0"/>
        <Grid VerticalAlignment="Center">
          <c:StatusBadge Status="{Binding Tracking.StateKind}"
                         Pulsing="{Binding Tracking.StatePulse}"
                         Text="{Binding Tracking.StateText}"
                         Visibility="{Binding Tracking.IsSlewing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
          <c:SlewingBadge Coord="{Binding Tracking.SlewCoord}"
                          Visibility="{Binding Tracking.IsSlewing, Converter={StaticResource BoolToVis}}"/>
        </Grid>
      </StackPanel>

      <!-- RIGHT: live RA/Dec/LST chips + console toggle -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Pill.Chip}" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="RA " Foreground="{DynamicResource Brush.TextFaint}" FontSize="11"
                       FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Position.RightAscension}" Foreground="{DynamicResource Brush.Text}"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Pill.Chip}" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Dec " Foreground="{DynamicResource Brush.TextFaint}" FontSize="11"
                       FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Position.Declination}" Foreground="{DynamicResource Brush.Text}"
                       FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ToggleButton x:Name="ConsoleToggleBtn" Margin="2,0,0,0"
                      IsChecked="{Binding Console.ConsoleVisible}"
                      Style="{StaticResource ToggleBtn.Console}"
                      VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Path Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="{StaticResource Geo.Console}"/>
            <TextBlock Text="Console" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
