<UserControl x:Class="ASCOM.OnStepX.Controls.TabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ASCOM.OnStepX.Converters"
             Height="40"
             Background="{DynamicResource Brush.Panel}"
             Focusable="False">
  <UserControl.Resources>
    <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>
  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
    <Grid>
      <ItemsControl x:Name="ItemsHost"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Padding="8,0"
                    Background="Transparent">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Animated underline indicator. Position/width set in code-behind. -->
      <Border x:Name="Indicator"
              Height="2"
              Width="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              CornerRadius="2,2,0,0"
              Background="{DynamicResource Brush.Accent}"
              IsHitTestVisible="False">
        <Border.RenderTransform>
          <TranslateTransform x:Name="IndicatorTx" X="0"/>
        </Border.RenderTransform>
      </Border>
    </Grid>
  </Border>
</UserControl>
