<UserControl x:Class="ASCOM.OnStepX.Controls.PolarAlignmentPad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <UserControl.Resources>
    <Style x:Key="PaJogBtn" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Brush.BtnBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Size.Radius}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BtnBgHover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.InputBorderHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaStopBtn" TargetType="Button" BasedOn="{StaticResource PaJogBtn}">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentInk}"/>
    </Style>
  </UserControl.Resources>

  <!-- Plus-shape layout. Vertical column = Alt (focuser 1, AXIS4),
       horizontal row = Az (focuser 2, AXIS5). Speed scales with distance
       from center: closer = Slow, further = Very Fast. STOP at center is
       shared by both axes. -->
  <Grid HorizontalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="58"/>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="50"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Alt column (col 3) — top of grid = positive Alt, bottom = negative. -->
    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="VF ↑" Margin="2" CommandParameter="1,1,3" Click="OnJog"/>
    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="F ↑"  Margin="2" CommandParameter="1,1,2" Click="OnJog"/>
    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="S ↑"  Margin="2" CommandParameter="1,1,1" Click="OnJog"/>

    <!-- Center STOP (shared by both axes). -->
    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource PaStopBtn}"
            Content="STOP" Margin="2" Click="OnStopAll"/>

    <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="S ↓"  Margin="2" CommandParameter="1,-1,1" Click="OnJog"/>
    <Button Grid.Row="5" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="F ↓"  Margin="2" CommandParameter="1,-1,2" Click="OnJog"/>
    <Button Grid.Row="6" Grid.Column="3" Style="{StaticResource PaJogBtn}"
            Content="VF ↓" Margin="2" CommandParameter="1,-1,3" Click="OnJog"/>

    <!-- Az row (row 3) — left of grid = negative Az, right = positive. -->
    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource PaJogBtn}"
            Content="←← VF" Margin="2" CommandParameter="2,-1,3" Click="OnJog"/>
    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource PaJogBtn}"
            Content="← F"   Margin="2" CommandParameter="2,-1,2" Click="OnJog"/>
    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource PaJogBtn}"
            Content="← S"   Margin="2" CommandParameter="2,-1,1" Click="OnJog"/>
    <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource PaJogBtn}"
            Content="S →"   Margin="2" CommandParameter="2,1,1" Click="OnJog"/>
    <Button Grid.Row="3" Grid.Column="5" Style="{StaticResource PaJogBtn}"
            Content="F →"   Margin="2" CommandParameter="2,1,2" Click="OnJog"/>
    <Button Grid.Row="3" Grid.Column="6" Style="{StaticResource PaJogBtn}"
            Content="VF →→" Margin="2" CommandParameter="2,1,3" Click="OnJog"/>

    <!-- Axis labels in two corners. -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Alt" Style="{StaticResource Text.Hint}"
               HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="6" Grid.Column="6" Text="Az" Style="{StaticResource Text.Hint}"
               HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
</UserControl>
